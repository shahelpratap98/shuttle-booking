# Leave the two Supabase values empty to run in DEMO MODE: sample data held in
# memory, sign in as any sample person, nothing is saved permanently.

# Supabase project (Project Settings -> API). Both values are public by design.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# The site origin, no trailing slash. Used in invite and password-reset links.
NEXT_PUBLIC_APP_URL=http://localhost:4420
# Server only. Needed for adding drivers and staff. Never commit, never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
